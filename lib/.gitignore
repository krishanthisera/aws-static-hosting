# Node / Yarn
node_modules/

# Turborepo
.turbo/

# Build output
# Function bundles are built in CI and published to the GitHub Packages
# registry (@krishanthisera/*). They are not committed to the repo.
**/build/
dist/

# Exception: the built uri-rewrite CloudFront Function bundle IS committed and
# consumed directly by the edge-functions Terraform module (aws_cloudfront_function
# has no S3/URL code source). A pre-commit hook rebuilds it from src/.
!cloudfront-functions/packages/uri-rewrite/build/
!cloudfront-functions/packages/uri-rewrite/build/index.js

# TypeScript
*.tsbuildinfo

# Lint / test caches and reports
.eslintcache
coverage/

# Package tarballs (npm pack / semantic-release dry runs)
*.tgz

# Lambda@Edge local packaging artifacts
function_archives/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

